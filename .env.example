# Salin berkas ini menjadi .env (jangan commit .env):
#   cp .env.example .env
# Lalu isi nilai di bawah dengan nilai Anda sendiri.
# APP_KEY boleh dikosongkan: entrypoint backend akan membuat dan
# menyimpannya di volume backend_storage saat pertama kali jalan.
# Jangan pernah menulis nilai-nilai ini ke dalam Dockerfile.

APP_KEY=

DB_DATABASE=inventaris_lab
DB_USERNAME=lab_user
DB_PASSWORD=isi_password_db_anda_di_sini
DB_ROOT_PASSWORD=isi_password_root_db_anda_di_sini
