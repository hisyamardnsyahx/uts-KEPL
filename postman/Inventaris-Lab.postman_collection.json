{"auth":{"bearer":[{"key":"token","value":"{{token}}"}],"type":"bearer"},"info":{"description":"Koleksi pengujian REST API Inventaris Lab (Laravel + Sanctum). Jalankan 'Login' dulu: skrip Tests-nya menyimpan token ke variabel collection 'token', lalu semua request lain memakai Bearer token itu. Variabel 'base_url' default http://localhost:8000 (backend langsung) — bila menguji lewat frontend, ganti menjadi http://localhost:8080.","name":"Inventaris Lab API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"item":[{"event":[{"listen":"test","script":{"exec":["pm.test('Status 200', function () { pm.response.to.have.status(200); });","var json = pm.response.json();","if (json.data && json.data.token) { pm.collectionVariables.set('token', json.data.token); }"],"type":"text/javascript"}}],"name":"Login","request":{"body":{"mode":"raw","raw":"{\n  \"email\": \"admin@lab.test\",\n  \"password\": \"password123\"\n}"},"header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/api/login"}},{"name":"Logout","request":{"header":[{"key":"Accept","value":"application/json"}],"method":"POST","url":"{{base_url}}/api/logout"}},{"name":"Profil user login","request":{"header":[{"key":"Accept","value":"application/json"}],"method":"GET","url":"{{base_url}}/api/user"}}],"name":"Auth"},{"item":[{"name":"Tampil semua","request":{"header":[{"key":"Accept","value":"application/json"}],"method":"GET","url":"{{base_url}}/api/equipments"}},{"name":"Tampil satu","request":{"header":[{"key":"Accept","value":"application/json"}],"method":"GET","url":"{{base_url}}/api/equipments/{{equipment_id}}"}},{"event":[{"listen":"test","script":{"exec":["pm.test('Status 201', function () { pm.response.to.have.status(201); });","var json = pm.response.json();","if (json.data && json.data.id) { pm.collectionVariables.set('equipment_id', String(json.data.id)); }"],"type":"text/javascript"}}